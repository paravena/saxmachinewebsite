# Canonical production origin. Used for canonical/Open Graph URLs, JSON-LD,
# robots.txt and sitemap.xml. Must match the Cloudflare Pages custom domain.
VITE_SITE_URL=https://www.saxmachineentertainment.com

# --- Analytics (optional) -------------------------------------------------
# Cookieless, GDPR-friendly: no consent banner required.
# VITE_PLAUSIBLE_DOMAIN=saxmachineentertainment.com
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Google Analytics 4. Requires a cookie-consent gate for EU visitors.
# VITE_GA_ID=G-XXXXXXXXXX

# --- Contact form ---------------------------------------------------------
# Public Cloudflare Turnstile site key (safe to ship in the client bundle).
# While this is unset the contact form falls back to the legacy `mailto:` flow.
# The matching TURNSTILE_SECRET_KEY is a server-side Pages secret — see
# .dev.vars.example. Cloudflare's always-pass test site key is
# 1x00000000000000000000AA.
# VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000
