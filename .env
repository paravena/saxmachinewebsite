# Canonical production origin. Used for canonical/Open Graph URLs, JSON-LD,
# robots.txt and sitemap.xml. Must match the Fly.io custom domain.
# NEXT_PUBLIC_* values are inlined at build time (this file is read inside the
# Docker build), so changing them requires a redeploy.
NEXT_PUBLIC_SITE_URL=https://www.saxmachineentertainment.com

# --- Analytics (optional) -------------------------------------------------
# Cookieless, GDPR-friendly: no consent banner required.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=saxmachineentertainment.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Google Analytics 4. Requires a cookie-consent gate for EU visitors.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Contact form ---------------------------------------------------------
# Public Cloudflare Turnstile site key (safe to ship in the client bundle).
# While this is unset the contact form falls back to the legacy `mailto:` flow.
# The matching TURNSTILE_SECRET_KEY is a server-side Fly secret — see
# .env.local.example. Cloudflare's always-pass test site key is
# 1x00000000000000000000AA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFZdJH2E7kXXznzE
