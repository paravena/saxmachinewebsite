# Copy to `.env.local` (gitignored) for local `npm run dev`.
# In production these are Fly.io secrets:
#   fly secrets set RESEND_API_KEY=... TURNSTILE_SECRET_KEY=...
# CONTACT_TO / CONTACT_FROM are plain values set in fly.toml under [env].

# Resend API key with "Sending access" only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Turnstile secret key (the site key is public and goes in .env).
# 1x0000000000000000000000000000000AA always passes — handy for local testing.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Inbox that receives the booking inquiries.
CONTACT_TO=saxmachinee@gmail.com

# Verified sender on the saxmachineentertainment.com domain (verified in Resend).
CONTACT_FROM=Sax Machine <noreply@saxmachineentertainment.com>
